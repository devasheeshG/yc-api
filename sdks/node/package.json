{
  "name": "yc-api",
  "version": "1.0.0",
  "description": "Typed TypeScript/JavaScript client for the unofficial Y Combinator companies API",
  "license": "MIT",
  "author": "Devasheesh Gupta",
  "repository": {
    "type": "git",
    "url": "https://github.com/devasheeshG/yc-api",
    "directory": "sdks/node"
  },
  "keywords": ["yc", "ycombinator", "api", "startups", "typescript"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
